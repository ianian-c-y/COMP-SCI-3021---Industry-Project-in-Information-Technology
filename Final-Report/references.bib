% 呢個係 references.bib file。所有引用嘅嘢 (citations) 都擺喺度。
% 你可以喺 Google Scholar 搵 "Cite" -> "BibTeX"，然後 copy-paste 啲 code 嚟呢度。

% 呢個係一篇 journal article (期刊文章) 嘅格式。
@article{example_article,
    author  = {Author, First A. and Author, Second B.},
    title   = {Title of an Example Article},
    journal = {Journal of Examples},
    year    = {2024},
    volume  = {10},
    number  = {2},
    pages   = {100--110},
}

% 呢個係一本書 (book) 嘅格式。
@book{example_book,
    author    = {Writer, Test T.},
    title     = {How to Write a Book},
    publisher = {Publisher Press},
    year      = {2023},
    address   = {Cityville},
}

% 呢個係網頁 (website) 嘅格式。
@online{example_website,
    author  = {Webber, W. W.},
    title   = {A Really Good Website},
    year    = {2025},
    url     = {https://www.example.com},
    urldate = {2025-10-25}, % 'urldate' 係你最後一次 access 條 link 嘅日期。
}